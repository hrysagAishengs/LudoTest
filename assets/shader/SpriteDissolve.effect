CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        # 貼圖參數要放前面
        noiseTexture: {}
        # vec, float系列要使用Uniform Const包起來
        edgeColour1: { value: [1.0, 1.0, 1.0, 1.0], editor: {type: color} }
        edgeColour2: { value: [1.0, 1.0, 1.0, 1.0], editor: {type: color} }
        edgeWidth: { value: 0.1 }
        fadeWidth1: { value: 0.1 }
        fadeWidth2: { value: 0.1 }
        level: { value: 0.0 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
    precision highp float;
    #include <builtin/internal/embedded-alpha>
    #include <builtin/internal/alpha-test>

    in vec4 color;
    in vec2 uv0;

    //用到內建的變數，查找internal/chunks/builtin/internal/sprite-texture.chunk
    //ios平台使用Metal一定要指定layout，否則cc_spriteTexture無法binding
    //web or Android可以不用指定layout
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

    //貼圖可以單獨放
    uniform sampler2D noiseTexture;

    uniform Constant{
        vec4 edgeColour1;
        vec4 edgeColour2;
        float edgeWidth;
        float fadeWidth1;
        float fadeWidth2;
        float level;
    };

    vec4 frag () {
      
        float cutout = clamp(CCSampleWithAlphaSeparated(noiseTexture, uv0).r, 0.0, 1.0);
        vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
        o *= color;
        
        if(cutout < level)
        {
            o.a = 0.0;
            ALPHA_TEST(o);
            return o;
        }

        float edgeHeight = level + edgeWidth;
        if(level > 0.0)
        {
            if(cutout < edgeHeight)
            {
              o.rgb = mix(edgeColour1.rgb, edgeColour2.rgb, clamp((cutout - level)/edgeWidth, 0.0, 1.0));
            }
            //fadeWith2 is mix of edgeColour2 
            else if(cutout < edgeHeight + fadeWidth2)
            {
              o.rgb = mix(edgeColour2.rgb, o.rgb, clamp((cutout - edgeHeight)/fadeWidth2, 0.0, 1.0));
            }
            //original o.rgb

            if(cutout < (level + fadeWidth1))
            {
              o.a *= (cutout - level)/fadeWidth1;
            }
        }
        ALPHA_TEST(o);
        return o;
    }
}%